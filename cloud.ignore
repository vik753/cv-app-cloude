# Files and folders that agents/Claude should skip reading.
# Build artifacts, dependencies, and generated/editor cruft — none of it
# is source of truth, so it just wastes context.

# Dependencies (huge, regenerable via package-lock.json)
node_modules/

# Build output (regenerable via `npm run build`)
dist/
dist-ssr/

# VCS internals
.git/

# Editor / OS metadata
.vscode/
.idea/
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Empty/unused placeholder (no content to index)
design_handoff_resume_canvas/

# Lockfile — large and machine-generated, rarely needs reading
package-lock.json
