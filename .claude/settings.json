{
	"permissions": {
		"allow": [
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git checkout:*)",
			"Bash(npm run:*)",
			"Bash(pnpm run:*)",
			"Read",
			"Edit"
		],
		"deny": ["Read(.env)", "Read(.env.*)", "Bash(cat .env:*)", "Bash(rm -rf:*)", "Bash(pnpm add:*)"],
		"ask": ["Bash(git push:*)", "WebFetch", "Bash(npm install:*)"]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [{ "type": "command", "command": "cd $CWD && npm run typecheck 2>&1 | tail -10" }]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "echo '=== Git Status ===' && git status -s && echo '=== Recent commits ===' && git log --oneline -5"
					}
				]
			}
		]
	}
}
